    {
      "id": 14,
      "title": "Server-side timings — lifetime weighted means",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 7
      },
      "description": "Cumulative weighted means since counter resets, not the dashboard time range. Confirm exporter unit mapping if scaled unexpectedly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "editorMode": "code",
          "expr": "sum(superset_ChartDataRestApi_data_time_sum{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_unit=~\"$juju_unit\"}) / (sum(superset_ChartDataRestApi_data_time_count{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_unit=~\"$juju_unit\"}) > 0)",
          "legendFormat": "Chart data",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
