   {
      "id": 3,
      "title": "Selected scrape targets — NOT process liveness",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "description": "Scrape target reachability (up=1), not Superset process liveness.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "editorMode": "code",
          "expr": "up{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_unit=~\"$juju_unit\"}",
          "legendFormat": "{{juju_unit}}",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1,
          "unit": "short",
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "pluginVersion": "9.5.3"
    },
    {
      "id": 4,
      "title": "Celery workers — online vs reported",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 7
      },
      "description": "Datasource-wide: worker label coverage is unknown, so Juju filters do not apply. Reported means observed hostnames, not desired replicas. A missing worker may vanish from both series; no telemetry is unknown, not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "editorMode": "code",
          "expr": "sum(max by (hostname) (celery_worker_up))",
          "legendFormat": "Online workers",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "editorMode": "code",
          "expr": "count(max by (hostname) (celery_worker_up))",
          "legendFormat": "Reported workers",
          "refId": "B",
          "format": "time_series",
          "instant": false,
          "range": true
